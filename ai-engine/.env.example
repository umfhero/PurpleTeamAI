# AI Engine Configuration
# Copy this file to .env and update with your settings

# Server Configuration
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=8766
LOG_LEVEL=INFO

# Model Provider: 'openai' or 'ollama'
MODEL_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=60

# Ollama Configuration (for local LLMs)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT=120

# Vector Store Configuration
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=text-embedding-3-small

# Knowledge Base
OWASP_DATA_PATH=./app/knowledge/data/owasp_top10.json
MITRE_DATA_PATH=./app/knowledge/data/mitre_attack.json
CVE_DATA_PATH=./app/knowledge/data/cve_database.json

# Risk Scoring
CVSS_WEIGHT=0.4
EXPLOIT_AVAILABILITY_WEIGHT=0.3
ASSET_CRITICALITY_WEIGHT=0.2
BUSINESS_IMPACT_WEIGHT=0.1

# Report Generation
REPORT_OUTPUT_PATH=./reports
REPORT_TEMPLATE_PATH=./app/reporting/templates
ENABLE_PDF_EXPORT=true

# Performance
MAX_CONCURRENT_REQUESTS=10
CACHE_ENABLED=true
CACHE_TTL=3600

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_EARLY_STOPPING=true

# Prompt Configuration
PROMPT_TEMPLATE_PATH=./app/prompts
USE_FEW_SHOT_EXAMPLES=true

# Security
ENABLE_INPUT_VALIDATION=true
SANITIZE_OUTPUTS=true

# Development
DEBUG=false
VERBOSE_LOGGING=false

# Cost Tracking (for OpenAI)
TRACK_TOKEN_USAGE=true
MONTHLY_BUDGET_USD=100
ALERT_ON_BUDGET_THRESHOLD=0.8
