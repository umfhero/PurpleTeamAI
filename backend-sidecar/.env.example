# Backend Sidecar Configuration
# Copy this file to .env and update with your settings

# Server Configuration
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8765
LOG_LEVEL=INFO

# Security Tool Paths
# Update these paths based on your system installation

# Nmap
NMAP_PATH=/usr/bin/nmap
# Windows: C:\Program Files (x86)\Nmap\nmap.exe
# macOS: /usr/local/bin/nmap

# Sublist3r
SUBLIST3R_PATH=/usr/local/bin/sublist3r
# Or if installed via pip: sublist3r

# SQLMap
SQLMAP_PATH=/path/to/sqlmap/sqlmap.py
# Or if installed globally: sqlmap

# Nikto
NIKTO_PATH=/usr/bin/nikto

# Tool Configuration
NMAP_TIMEOUT=300
SCAN_MAX_CONCURRENT=5
RESULT_CACHE_TTL=3600

# API Keys (Optional)
SHODAN_API_KEY=your_shodan_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AI Engine Connection
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=8766

# Performance
MAX_WORKERS=4
QUEUE_SIZE=100

# Security
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=60

# Development
DEBUG=false
ENABLE_CORS=true
